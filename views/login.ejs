<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Ruang Tugas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-900 font-sans">

  <!-- Navbar -->


  <!-- Login Section -->
  <section class="flex items-center justify-center min-h-screen px-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-center mb-2">Masuk Ke RuangTugas</h2>
      <p class="text-gray-600 text-center mb-6">Login untuk melanjutkan</p>

      <!-- Form -->
      <form action="#" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Email</label>
          <div class="mt-1 relative">
            <input type="email" placeholder="youremail@example.com" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-black focus:outline-none text-sm">
            <i class="fas fa-envelope absolute right-4 top-3 text-gray-400"></i>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Password</label>
          <div class="mt-1 relative">
            <input type="password" placeholder="********" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-black focus:outline-none text-sm">
            <i class="fas fa-lock absolute right-4 top-3 text-gray-400"></i>
          </div>
        </div>

        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center space-x-2">
            <input type="checkbox" class="rounded border-gray-300">
            <span>Ingat saya</span>
          </label>
          <a href="#" class="text-black hover:underline">Lupa Password?</a>
        </div>

        <button type="submit" class="w-full bg-black text-white py-3 rounded-lg font-medium hover:bg-gray-800 transition">
          Login
        </button>
      </form>

      <!-- Divider -->
      <div class="flex items-center my-6">
        <hr class="flex-grow border-gray-300">
        <span class="px-3 text-sm text-gray-500">atau</span>
        <hr class="flex-grow border-gray-300">
      </div>

      <!-- Social Login -->
      <div class="flex flex-col space-y-3">
        <button class="flex items-center justify-center border border-gray-300 rounded-lg py-2.5 hover:bg-gray-50">
          <i class="fab fa-google text-red-500 mr-2"></i> Login dengan Google
        </button>
        <button class="flex items-center justify-center border border-gray-300 rounded-lg py-2.5 hover:bg-gray-50">
          <i class="fab fa-facebook text-blue-600 mr-2"></i> Login dengan Facebook
        </button>
      </div>

      <!-- Register -->
      <p class="text-center text-sm text-gray-600 mt-6">
        Belum punya akun? 
        <a href="#" class="text-black font-medium hover:underline">Daftar Sekarang</a>
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-100 py-6 border-t border-gray-200 text-center text-sm text-gray-500">
    © 2023 Ruang Tugas. All rights reserved.
  </footer>

</body>
</html>
